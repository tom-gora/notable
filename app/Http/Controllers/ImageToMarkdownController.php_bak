<?php

namespace App\Http\Controllers;

use Illuminate\Routing\Controller;
use Illuminate\Support\Facades\Http;
use Illuminate\Support\Facades\Log;

class ImageToMarkdownController extends Controller {
    protected string $endpoint;

    protected string $api_key;

    protected string $model;

    protected string $prompt;

    public function __construct() {
        $this->endpoint = rtrim((string) config('app.ai.endpoint'), '/');
        $this->api_key  = (string) config('app.ai.api_key');
        $this->model    = (string) config('app.ai.model');
        $this->prompt   = (string) config('app.ai.prompt');
    }

    /**
     * @return array<string, mixed>
     */
    private function buildPayload(string $base64) : array {
        return [
            'model' => $this->model,
            'messages' => [
                [
                    'role' => 'user',
                    'content' => [
                        ['type' => 'text', 'text' => $this->prompt],
                        [
                            'type' => 'image_url',
                            'image_url' => [
                                'url' => 'data:image/jpeg;base64,' . $base64,
                            ],
                        ],
                    ],
                ],
            ],
        ];
    }

    /**
     * @param  array<string, mixed>  $payload
     * @return array<string, mixed>|null
     */
    private function makeRequest(array $payload) : ?array {
        $url = $this->endpoint ;
        $response = Http::withHeaders([
            'Authorization' => 'Bearer ' . $this->api_key,
            'Content-Type' => 'application/json',
        ])->timeout(120)->post($url, $payload);

        if (!$response->successful()) {
            Log::error('AI vision API request failed', [
                'status' => $response->status(),
                'body' => $response->body(),
            ]);
            return null;
        }
        return $response->json();
    }

    public function noteToText(string $base64) : ?string {
        $payload = $this->buildPayload($base64);
        $response_json = $this->makeRequest($payload);
        if ($response_json === null) {
            return null;
        }
        return $response_json['choices'][0]['message']['content'] ?? null;
    }
}
